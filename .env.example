# Runtime connection. Locally it points to the `db` service from compose.yaml; on Vercel, Neon injects the pooled URL.
DATABASE_URL="postgresql://granabank:granabank@localhost:5442/granabank"

# Direct (unpooled) connection used by the Prisma CLI for migrations. Optional locally.
# DATABASE_URL_UNPOOLED=""

# Throwaway database for integration tests (`pnpm test:db:up`).
TEST_DATABASE_URL="postgresql://granabank:granabank@localhost:5443/granabank_test"

# Demo user created by `pnpm db:seed` (the challenge credentials).
SEED_USER_EMAIL="soygranate@clublanus.com"
SEED_USER_PASSWORD="GRANATE1@"
